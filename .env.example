# Salin ke .env lalu sesuaikan. JANGAN commit .env.
#
# Cuma dua variabel, dan KEDUANYA di-inline saat build (prefix NEXT_PUBLIC_),
# bukan dibaca saat runtime — mengubahnya di Vercel WAJIB diikuti redeploy,
# restart saja tidak cukup.

# Base URL REST API. Sufiks /api/v1 WAJIB ikut: lib/api/client.ts menyambung
# path seperti "/auth/refresh" langsung ke nilai ini. Tanpa slash di akhir.
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# Endpoint Socket.IO. "/realtime" di sini adalah NAMESPACE Socket.IO, bukan
# path — handshake tetap terjadi di /socket.io/ pada root domain. Pakai skema
# https:// di produksi (bukan wss://); Socket.IO yang menurunkannya sendiri.
NEXT_PUBLIC_WS_URL=http://localhost:3002/realtime
